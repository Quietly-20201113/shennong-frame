registry=https://registry.npmmirror.com

# 自家 scope 走本地 Verdaccio 私服（开发期默认 localhost:4873）
# 生产环境由甲方在 ~/.npmrc 中覆盖为内网域名
@shennong:registry=http://localhost:4873/
@shennong-core:registry=http://localhost:4873/

public-hoist-pattern[]=lefthook
public-hoist-pattern[]=eslint
public-hoist-pattern[]=oxfmt
public-hoist-pattern[]=oxlint
public-hoist-pattern[]=stylelint
public-hoist-pattern[]=*postcss*
public-hoist-pattern[]=@commitlint/*
public-hoist-pattern[]=czg

strict-peer-dependencies=false
auto-install-peers=true
dedupe-peer-dependents=true
