registry=https://registry.npmmirror.com

# 自家 scope 走团队内网私服（scoped 包 publish/install 都认这个作用域源，
# 命令行 --registry 对 scoped 包无效，必须在这里指对）。本地测试可临时改回 localhost:4873。
@shennong:registry=http://172.10.254.68:4873/
@shennong-core:registry=http://172.10.254.68:4873/

# 内网私服已放行匿名 publish（config 里 publish:$all）；但 npm 客户端「没 token 不肯发」，
# 给个占位串满足它即可（服务器按匿名处理，这串无实际意义）。要恢复账号鉴权就删掉此行 + config 改回 $authenticated。
//172.10.254.68:4873/:_authToken=anonymous

public-hoist-pattern[]=lefthook
public-hoist-pattern[]=eslint
public-hoist-pattern[]=oxfmt
public-hoist-pattern[]=oxlint
public-hoist-pattern[]=stylelint
public-hoist-pattern[]=*postcss*
public-hoist-pattern[]=@commitlint/*
public-hoist-pattern[]=czg

strict-peer-dependencies=false
auto-install-peers=true
dedupe-peer-dependents=true
