{
  "name": "shennong-frame-monorepo",
  "version": "5.7.0",
  "private": true,
  "keywords": [
    "monorepo",
    "turbo",
    "shennong",
    "shennong-frame",
    "erp",
    "vue",
    "vue3",
    "admin",
    "fork-from-vue-vben-admin"
  ],
  "homepage": "",
  "bugs": "",
  "repository": "",
  "license": "MIT",
  "author": {
    "name": "shennong",
    "email": "",
    "url": ""
  },
  "type": "module",
  "scripts": {
    "bootstrap": "pnpm install",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 turbo build",
    "build:analyze": "turbo build:analyze",
    "build:antd": "pnpm run build --filter=@shennong/web-antd",
    "build:docker": "./scripts/deploy/build-local-docker-image.sh",
    "build:docs": "pnpm run build --filter=@shennong/docs",
    "build:ele": "pnpm run build --filter=@shennong/web-ele",
    "build:naive": "pnpm run build --filter=@shennong/web-naive",
    "build:tdesign": "pnpm run build --filter=@shennong/web-tdesign",
    "build:play": "pnpm run build --filter=@shennong/playground",
    "changeset": "pnpm exec changeset",
    "check": "pnpm run check:circular && pnpm run check:dep && pnpm run check:type && pnpm check:cspell",
    "check:circular": "vsh check-circular",
    "check:cspell": "cspell lint \"**/*.ts\" \"**/README.md\" \".changeset/*.md\" --no-progress",
    "check:dep": "vsh check-dep",
    "check:type": "turbo run typecheck",
    "clean": "node ./scripts/clean.mjs",
    "commit": "czg",
    "dev": "turbo-run dev",
    "dev:antd": "pnpm -F @shennong/web-antd run dev",
    "dev:erp-admin": "pnpm -F @shennong/erp-admin run dev",
    "dev:antdv-next": "pnpm -F @shennong/web-antdv-next run dev",
    "dev:docs": "pnpm -F @shennong/docs run dev",
    "dev:ele": "pnpm -F @shennong/web-ele run dev",
    "dev:naive": "pnpm -F @shennong/web-naive run dev",
    "dev:tdesign": "pnpm -F @shennong/web-tdesign run dev",
    "dev:play": "pnpm -F @shennong/playground run dev",
    "format": "vsh lint --format",
    "lint": "vsh lint",
    "postinstall": "pnpm -r run stub --if-present",
    "preinstall": "npx only-allow pnpm",
    "prepare": "is-ci || pnpm exec lefthook install",
    "preview": "turbo-run preview",
    "publint": "vsh publint",
    "reinstall": "pnpm clean --del-lock && pnpm install",
    "test:unit": "vitest run --dom",
    "test:e2e": "turbo run test:e2e",
    "update:deps": "npx taze -r -w",
    "version": "pnpm exec changeset version && pnpm install --no-frozen-lockfile",
    "release:private": "pnpm run version && pnpm build && pnpm publish -r --filter \"@shennong/*\" --filter \"@shennong-core/*\" --no-git-checks --access=public",
    "catalog": "pnpx codemod pnpm/catalog"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@tsdown/css": "catalog:",
    "@types/node": "catalog:",
    "@shennong/commitlint-config": "workspace:*",
    "@shennong/eslint-config": "workspace:*",
    "@shennong/oxfmt-config": "workspace:*",
    "@shennong/oxlint-config": "workspace:*",
    "@shennong/stylelint-config": "workspace:*",
    "@shennong/tailwind-config": "workspace:*",
    "@shennong/tsconfig": "workspace:*",
    "@shennong/turbo-run": "workspace:*",
    "@shennong/vite-config": "workspace:*",
    "@shennong/vsh": "workspace:*",
    "@vitejs/plugin-vue": "catalog:",
    "@vitejs/plugin-vue-jsx": "catalog:",
    "cross-env": "catalog:",
    "cspell": "catalog:",
    "happy-dom": "catalog:",
    "is-ci": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "playwright": "catalog:",
    "rimraf": "catalog:",
    "tailwindcss": "catalog:",
    "tsdown": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  },
  "engines": {
    "node": "^20.19.0 || ^22.18.0 || ^24.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.33.0"
}
